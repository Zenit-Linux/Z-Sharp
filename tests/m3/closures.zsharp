# M3: domknięcia, funkcje strzałkowe, wywołania wartości
func apply($f, $x) { return $f($x); }
func make_adder($n) { return func($x) { return $x + $n; }; }
func compose($f, $g) { return fn($x) => $f($g($x)); }
func counter_demo() {
    $c = 0;
    $inc = func() { $c = $c + 1; return $c; };
    echo $inc(), $inc(), $c;      # przechwycenie przez wartość: 1 1 0
}

$double = fn($x) => $x * 2;
$add5 = make_adder(5);
echo apply($double, 21);
echo $add5(10);
echo compose($double, $add5)(1);
echo apply(func($s) { return $s . "!"; }, "hej");
counter_demo();

$k = 100;
$withDefault = func($a, $b = 7) { return $a + $b + $k; };
echo $withDefault(1), $withDefault(1, 2), $withDefault(b: 3, a: 4);

$fs = [];
for ($i = 0; $i < 3; $i++) { $fs[] = fn($x) => $x + $i; }
echo $fs[0](10), $fs[1](10), $fs[2](10);

$nested = fn($a) => fn($b) => fn($c) => $a . $b . $c;
echo $nested("x")("y")("z");

func rec_fact($n) { return $n <= 1 ? 1 : $n * rec_fact($n - 1); }
$byName = "rec_fact";
echo $byName(5);
echo is_callable($double), is_callable(3);
echo typeof($double);
