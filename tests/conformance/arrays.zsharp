# tablice: kolejność, klucze, kopiowanie przy zapisie, zagnieżdżenia
$a = [1, 2, 3];
$b = $a;
$b[] = 4;
$b[0] = 99;
echo $a, $b, count($a), count($b);
$m = ["x" => 1, "y" => 2, 5 => "five", "7" => "seven"];
$m[] = "next";
$m["z"] = 3;
echo $m, keys($m), values($m), has_key($m, "y"), has_key($m, 7), has_key($m, "nope");
$n = [];
$n["a"]["b"][] = 1;
$n["a"]["b"][] = 2;
$n["a"]["c"] = [1, [2, [3]]];
$n["a"]["c"][1][1][] = 4;
echo $n;
$copy = $n;
$copy["a"]["b"][0] = "changed";
echo $n["a"]["b"], $copy["a"]["b"];
$k = [1.0 => "f", true => "t", "08" => "s", "8" => "i", -3 => "neg"];
echo $k;
$i = 0;
$arr = [10, 20, 30];
$arr[$i++] += 5;
$arr[$i] *= 2;
$arr[2]++;
--$arr[2];
$arr["new"] ??= "dflt";
$arr["new"] ??= "again";
echo $arr, $i;
echo range(1, 5), range(5, 1), range(3, 3);
echo array_slice([1, 2, 3, 4, 5], 1, 2), array_slice([1, 2, 3], -2), array_slice([1, 2, 3], 1);
echo sort([3, 1, 2, 10, -1]), sort(["b", "a", "C", "é"]), sort([2.5, 1, 3]);
echo in_array(2, [1, 2]), in_array("2", [1, 2]), in_array(null, [null]);
echo push([1], 2), [1, 2] + [5, 6, 7], [] + ["a" => 1];
foreach ([5, 6, 7] as $idx => $v) { echo $idx, $v; }
$src = [1, 2, 3];
foreach ($src as $v) { $src[] = $v * 10; }
echo $src;
$e = [];
try { echo $e["missing"]; } catch (Exception $x) { echo "E:", $x->getMessage(); }
echo $e["missing"] ?? "dflt", $e["a"]["b"] ?? "deep";
try { $s = "str"; $s[0] = "x"; } catch (Exception $x) { echo "E:", $x->getMessage(); }
