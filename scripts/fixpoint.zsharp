#!/usr/bin/env zsi
# Punkt stały: zsc (jako .zbc) kompiluje sam siebie. s1 == s2 == s3 (bajt w bajt), potem pakiet standalone.
import Std.Os;
import Workspace.Scripts;

func main() {
    Scripts.ensureStage0();
    $z = Scripts.zsc0();
    $zscDir = Scripts.requireZscDir("fixpoint");
    $created = Scripts.linkWorkspace($zscDir);
    $t = Scripts.tmp();
    $src = $zscDir . "/src/main.zsharp";
    try {
        Scripts.must("stage0 -> s1", $z, ["run", $src, "build", $src, "--emit", "zbc", "-o", $t . "/s1.zbc"]);
        Scripts.must("s1 -> s2", $z, ["exec", $t . "/s1.zbc", "build", $src, "--emit", "zbc", "-o", $t . "/s2.zbc"]);
        Scripts.must("s2 -> s3", $z, ["exec", $t . "/s2.zbc", "build", $src, "--emit", "zbc", "-o", $t . "/s3.zbc"]);
        if (!Scripts.sameFile($t . "/s1.zbc", $t . "/s2.zbc") || !Scripts.sameFile($t . "/s2.zbc", $t . "/s3.zbc")) {
            Scripts.die("fixpoint: s1, s2, s3 różnią się");
        }
        echo "fixpoint: s1 == s2 == s3 (" . Scripts.fileSize($t . "/s3.zbc") . " B)";
        # samodzielna binarka zsc (runtime + zbc), bez Rusta w ścieżce użytkownika
        Scripts.must("bundle", $z, ["bundle", $t . "/s3.zbc", "-o", $t . "/zsc"]);
        Os.writeFile($t . "/p.zs", "echo \"fixpoint-ok\", 40 + 2;\n");
        Scripts.must("standalone zsc build", $t . "/zsc", ["build", $t . "/p.zs", "-o", $t . "/p"]);
        if (trim(Scripts.must("uruchomienie programu", $t . "/p")) !== "fixpoint-ok 42") { Scripts.die("standalone zsc: zły wynik programu"); }
        echo "standalone zsc: buduje i uruchamia program natywny";
    } catch (Exception $e) {
        Scripts.unlinkWorkspace($zscDir, $created);
        Os.removeAll($t);
        throw $e;
    }
    Scripts.unlinkWorkspace($zscDir, $created);
    Os.removeAll($t);
}

main();
