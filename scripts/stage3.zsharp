#!/usr/bin/env zsi
# stage3: natywna samokompilacja zsc (bez interpretera w kompilatorze).
#   stage2: zsc0 (interpreter) buduje zsc natywnie (C)  -> zsc2
#   stage3: zsc2 buduje zsc natywnie                      -> zsc3
#   stage4: zsc3 buduje zsc natywnie                      -> zsc4
# Warunek: C wygenerowany przez interpreter, zsc2, zsc3 i zsc4 dla zsc jest identyczny (punkt stały), oraz
# zsc3 generuje identyczny C jak interpreter dla wszystkich testów natywnych.
import Std.Os;
import Workspace.Scripts;

func countLines($p) { return count(split(Os.readFile($p), "\n")) - 1; }

func main() {
    Scripts.ensureStage0();
    $z = Scripts.zsc0();
    $zscDir = Scripts.requireZscDir("stage3");
    $created = Scripts.linkWorkspace($zscDir);
    $t = Scripts.tmp();
    $main = $zscDir . "/src/main.zsharp";
    try {
        Scripts.step("stage2: interpreter -> zsc natywny");
        Scripts.must("zsc2", $z, ["run", $main, "build", $main, "-o", $t . "/zsc2"]);
        Scripts.must("ref.c", $z, ["run", $main, "build", $main, "--emit", "c", "-o", $t . "/ref.c"]);
        Scripts.step("stage3/4: zsc natywny buduje siebie");
        Scripts.must("zsc3", $t . "/zsc2", ["build", $main, "-o", $t . "/zsc3"]);
        Scripts.must("zsc4", $t . "/zsc3", ["build", $main, "-o", $t . "/zsc4"]);
        foreach (["zsc2", "zsc3", "zsc4"] as $s) {
            Scripts.must("C z " . $s, $t . "/" . $s, ["build", $main, "--emit", "c", "-o", $t . "/" . $s . ".c"]);
            if (!Scripts.sameFile($t . "/ref.c", $t . "/" . $s . ".c")) { Scripts.die("C z " . $s . " różni się od C z interpretera"); }
        }
        echo "   punkt stały: C identyczny (" . countLines($t . "/ref.c") . " linii) dla interpretera, zsc2, zsc3, zsc4";
        Scripts.step("zsc3 vs interpreter na testach natywnych");
        $n = 0;
        foreach (Scripts.filesIn($zscDir . "/tests/native", ".zsharp") as $f) {
            Scripts.sh($z, ["run", $main, "build", $f, "--emit", "c", "-o", $t . "/a.c"]);
            Scripts.sh($t . "/zsc3", ["build", $f, "--emit", "c", "-o", $t . "/b.c"]);
            $a = Os.isFile($t . "/a.c");
            $b = Os.isFile($t . "/b.c");
            if ($a !== $b || ($a && !Scripts.sameFile($t . "/a.c", $t . "/b.c"))) { Scripts.die("różnica dla " . $f); }
            if ($a) { Os.remove($t . "/a.c"); }
            if ($b) { Os.remove($t . "/b.c"); }
            $n++;
        }
        echo "   " . $n . " programów: identyczny C";
    } catch (Exception $e) {
        Scripts.unlinkWorkspace($zscDir, $created);
        Os.removeAll($t);
        throw $e;
    }
    Scripts.unlinkWorkspace($zscDir, $created);
    Os.removeAll($t);
    echo "stage3: OK";
}

main();
