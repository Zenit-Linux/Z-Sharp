#!/usr/bin/env zsi
# Parytet parsera: S-expr Rust (--sexp) == parser w Z# (lib/parser.zsharp).
import Std.Os;
import Workspace.Scripts;

func runParserParity() {
    Scripts.ensureStage0();
    $z = Scripts.zsc0();
    $r = Scripts.root();
    $n = 0;
    foreach (Scripts.paritySources($r) as $f) {
        $rust = join(Scripts.lines(Scripts.combined(Scripts.sh($z, ["--sexp", $f]))), "\n");
        $zs = join(Scripts.lines(Scripts.combined(Scripts.sh($z, ["run", $r . "/tests/parse_cli.zsharp", $f]))), "\n");
        if ($rust !== $zs) { echo "RÓŻNICA parsera: " . $f; return false; }
        $n++;
    }
    echo "parser parity: " . $n . " plików OK";
    return true;
}

if (!runParserParity()) { Os.exit(1); }
