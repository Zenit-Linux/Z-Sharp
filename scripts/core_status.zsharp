#!/usr/bin/env zsi
# Rozliczenie rdzenia: ile kodu jest w Z#, a ile w ziarnie (Rust stage0) i w runtime C.
import Std.Os;
import Std.Path;
import Workspace.Scripts;

func row($name, $n) { echo pad_right($name, 34) . pad_left(strval($n), 8); return null; }

# wszystkie pliki z rozszerzeniem pod katalogiem (bez target/)
func tree($dir, $ext) {
    $out = [];
    foreach (Os.walk($dir) as $p) {
        if (contains($p, "/target/")) { continue; }
        if (ends_with($p, $ext) && Os.isFile($p)) { $out[] = $p; }
    }
    return $out;
}

func main() {
    $r = Scripts.root();
    row("człon", "linii");
    foreach (["lexer", "parser", "sema", "ir", "emit_c", "emit_llvm", "zbc", "manifest", "cli", "link", "classes", "closures", "prelude"] as $f) {
        row("lib/" . $f . ".zsharp (Z#)", Scripts.loc([$r . "/lib/" . $f . ".zsharp"]));
    }
    foreach (["bytecode", "vm"] as $f) {
        if (Os.isFile($r . "/lib/" . $f . ".zsharp")) { row("lib/" . $f . ".zsharp (Z#)", Scripts.loc([$r . "/lib/" . $f . ".zsharp"])); }
    }
    row("wrapper/main.zsharp (Z#)", Scripts.loc([$r . "/wrapper/main.zsharp"]));
    row("zamm + runtime w Z#", Scripts.loc(array_merge_lists(Scripts.filesIn($r . "/zamm", ".zsharp"), Scripts.filesIn($r . "/runtime", ".zsharp"))));
    row("stdlib (Z#)", Scripts.loc(Scripts.filesIn($r . "/stdlib", ".zsharp")));
    row("runtime/native (C)", Scripts.loc(array_merge_lists(Scripts.filesIn($r . "/runtime/native", ".c"), Scripts.filesIn($r . "/runtime/include", ".h"))));
    $rust = Scripts.loc(tree($r . "/stage0", ".rs"));
    row("stage0 (Rust, ziarno)", $rust);
    $z = Scripts.loc(Scripts.filesIn($r . "/lib", ".zsharp"));
    echo "frontend+backendy w Z#: " . $z . " linii; ziarno Rust: " . $rust . " linii";
}

func array_merge_lists($a, $b) {
    foreach ($b as $x) { $a[] = $x; }
    return $a;
}

main();
