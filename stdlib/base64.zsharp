namespace Base64;

##
 * Std.Base64 — Base64 (RFC 4648) i szesnastkowo (hex).
 *   encode, decode, encodeUrl, decodeUrl, encodeBytes, decodeBytes, valid, hexEncode, hexDecode
 * Tekst jest kodowany jako bajty UTF-8; wersje *Bytes pracują na tablicach liczb 0..255.
 * `Url` = alfabet bezpieczny dla URL (-_) bez dopełnienia `=`.
##

func alphabet($url) {
    return $url ? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_" : "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}

func encodeWith($bytes, $url) {
    $abc = alphabet($url);
    $n = count($bytes);
    $out = [];
    $i = 0;
    while ($i < $n) {
        $b0 = $bytes[$i];
        $b1 = $i + 1 < $n ? $bytes[$i + 1] : 0;
        $b2 = $i + 2 < $n ? $bytes[$i + 2] : 0;
        $v = ($b0 << 16) | ($b1 << 8) | $b2;
        $out[] = substr($abc, ($v >> 18) & 63, 1);
        $out[] = substr($abc, ($v >> 12) & 63, 1);
        if ($i + 1 < $n) { $out[] = substr($abc, ($v >> 6) & 63, 1); } else if (!$url) { $out[] = "="; }
        if ($i + 2 < $n) { $out[] = substr($abc, $v & 63, 1); } else if (!$url) { $out[] = "="; }
        $i += 3;
    }
    return implode_chars($out);
}

func implode_chars($parts) {
    $r = "";
    foreach ($parts as $p) { $r .= $p; }
    return $r;
}

func encodeBytes($bytes) { return encodeWith($bytes, false); }
func encode($text) { return encodeWith(System.bytes(strval($text)), false); }
func encodeUrl($text) { return encodeWith(System.bytes(strval($text)), true); }

func decodeBytes($s) {
    $n = strlen($s);
    $out = [];
    $acc = 0;
    $bits = 0;
    for ($i = 0; $i < $n; $i++) {
        $c = substr($s, $i, 1);
        if ($c === "=" || $c === "\n" || $c === "\r" || $c === " " || $c === "\t") { continue; }
        $v = -1;
        $o = ord($c);
        if ($o >= 65 && $o <= 90) { $v = $o - 65; }
        else if ($o >= 97 && $o <= 122) { $v = $o - 71; }
        else if ($o >= 48 && $o <= 57) { $v = $o + 4; }
        else if ($c === "+" || $c === "-") { $v = 62; }
        else if ($c === "/" || $c === "_") { $v = 63; }
        if ($v < 0) { throw new Exception("Base64: niepoprawny znak na pozycji " . $i); }
        $acc = (($acc << 6) | $v) & 0xFFFFFF;
        $bits += 6;
        if ($bits >= 8) {
            $bits -= 8;
            $out[] = ($acc >> $bits) & 255;
        }
    }
    return $out;
}

func decode($s) { return System.fromBytes(decodeBytes($s)); }
func decodeUrl($s) { return System.fromBytes(decodeBytes($s)); }

func valid($s) {
    try { decodeBytes($s); return true; } catch (Exception $e) { return false; }
}

# ── hex ──
func hexEncode($data) {
    $bytes = is_array($data) ? $data : System.bytes(strval($data));
    $r = "";
    foreach ($bytes as $b) { $r .= ($b < 16 ? "0" : "") . to_hex($b); }
    return $r;
}

func hexDecode($s) {
    $n = strlen($s);
    if ($n % 2 !== 0) { throw new Exception("Hex: nieparzysta długość"); }
    $out = [];
    for ($i = 0; $i < $n; $i += 2) {
        $pair = substr($s, $i, 2);
        if (!is_hex_digit(substr($pair, 0, 1)) || !is_hex_digit(substr($pair, 1, 1))) { throw new Exception("Hex: niepoprawny znak na pozycji " . $i); }
        $out[] = hexVal(substr($pair, 0, 1)) * 16 + hexVal(substr($pair, 1, 1));
    }
    return $out;
}

func hexVal($c) {
    $o = ord($c);
    if ($o >= 48 && $o <= 57) { return $o - 48; }
    if ($o >= 97 && $o <= 102) { return $o - 87; }
    return $o - 55;
}
