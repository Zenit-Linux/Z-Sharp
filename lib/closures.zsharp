namespace closures;

import Workspace.parser;

##
 * M3 w backendach natywnych: domknięcia, funkcje strzałkowe, wywołania wartości, argumenty nazwane i rozwinięcie `...`.
 * Przebieg AST → AST (po classes.desugar, przed variadic_pass), więc oba backendy (C i LLVM) dostają tylko
 * konstrukcje, które już znają:
 *  - domknięcie `func(...) {...}` / `fn(...) => e` = funkcja `__lamN($__cap, ...)` + wartość `zs_mkfn(N, [zmienne => wartości])`;
 *    przechwytywanie przez wartość (jak w stage0): zmienne wolne obecne w otaczającym zasięgu kopiowane przy tworzeniu;
 *  - wywołanie wartości `$f(a, b)` = `zs_call($f, [a, b])`; `zs_call` to generowany dyspozytor po id lambdy
 *    (lub nazwie funkcji, gdy nazwa występuje jako literał tekstowy albo funkcja jest wołana z rozwinięciem);
 *  - argumenty nazwane przy znanej funkcji: statyczne uporządkowanie (brakujące środkowe -> wartości domyślne);
 *  - `f(...$tab, x)`: argumenty składane w tablicę (`zs_spread`) i wołane przez `zs_call("f", tablica)`.
 * Binder (bindArgs) wiąże tablicę argumentów z parametrami: pozycja, potem nazwa, potem wartość domyślna.
##

func nm($line, $n) { return [":Name", $line, $n]; }
func str($line, $s) { return [":Str", $line, $s]; }
func var($line, $n) { return [":Var", $line, $n]; }
func intl($line, $i) { return [":Int", $line, $i]; }
func arg($e) { return [":Arg", 0, null, $e, false]; }
func call($line, $fn, $args) {
    $as = [];
    foreach ($args as $a) { $as[] = arg($a); }
    return [":Call", $line, nm($line, $fn), $as];
}
func param($name) { return [":Param", 0, $name, [], null, false]; }

##
 * Lista argumentów wiążąca tablicę `$argsName` z parametrami: pozycja i, potem nazwa, potem domyślna / błąd.
 * Parametr wariadyczny dostaje resztę pozycyjną (rozwinięcie — łączy go variadic_pass).
##
func bindArgs($line, $params, $argsName, $fname) {
    $out = [];
    for ($i = 0; $i < count($params); $i++) {
        $p = $params[$i];
        if ($p[5]) {
            $out[] = [":Arg", 0, null, call($line, "array_slice", [var($line, $argsName), intl($line, $i)]), true];
            continue;
        }
        $a = var($line, $argsName);
        $d = $p[4] !== null ? $p[4] : call($line, "zs_arg_missing", [str($line, $fname), str($line, $p[2])]);
        $byName = [":Ternary", $line, call($line, "has_key", [$a, str($line, $p[2])]), [":Index", $line, $a, str($line, $p[2])], $d];
        $out[] = arg([":Ternary", $line, call($line, "has_key", [$a, intl($line, $i)]), [":Index", $line, $a, intl($line, $i)], $byName]);
    }
    return $out;
}

class Lifter {
    public $n = 0;
    public $out = [];        # wygenerowane FuncStmt (__lamN)
    public $lams = [];       # id => parametry lambdy (bez $__cap)
    public $fnp = [];        # funkcje użytkownika: nazwa => parametry
    public $named = [];      # funkcje wołane przez zs_call po nazwie
    public $dyn = false;
    public $usesSpread = false;
    public $sawHelper = false;
    public $errors = [];
    public $acc = [];

    func err($line, $m) { $this->errors[] = [$line, "E0104", $m]; }

    # zmienne występujące w x (bez wchodzenia do domknięć; domknięcie wnosi swoje zmienne wolne)
    func scan($x) {
        if (!is_array($x)) { return; }
        if (parser.isNode($x)) {
            $k = $x[0];
            if ($k === ":Var") { $this->acc[$x[2]] = true; return; }
            if ($k === ":Closure") { foreach ($this->freeOf($x[2]) as $n) { $this->acc[$n] = true; } return; }
            if ($k === ":Foreach") {
                if ($x[3] !== null) { $this->acc[$x[3]] = true; }
                if ($x[4] !== null) { $this->acc[$x[4]] = true; }
            }
            if ($k === ":Catch" && $x[3] !== null) { $this->acc[$x[3]] = true; }
        }
        foreach ($x as $v) { $this->scan($v); }
    }

    func names($x) {
        $save = $this->acc;
        $this->acc = [];
        $this->scan($x);
        $r = $this->acc;
        $this->acc = $save;
        return $r;
    }

    # zmienne wolne funkcji: użyte w ciele i domyślnych wartościach, bez parametrów
    func freeOf($f) {
        $r = $this->names($f[5]);
        foreach ($this->names($f[3]) as $n => $t) { $r[$n] = true; }
        $pn = [];
        foreach ($f[3] as $p) { $pn[$p[2]] = true; }
        $out = [];
        foreach ($r as $n => $t) { if (!has_key($pn, $n)) { $out[] = $n; } }
        return $out;
    }

    func lift($x, $vis) {
        $f = $x[2];
        $line = $x[1];
        $cap = [];
        foreach ($this->freeOf($f) as $n) { if (has_key($vis, $n)) { $cap[] = $n; } }
        $id = $this->n;
        $this->n++;
        $vis2 = $this->names($f[5]);
        foreach ($f[3] as $p) { $vis2[$p[2]] = true; }
        foreach ($cap as $n) { $vis2[$n] = true; }
        $body = [];
        foreach ($cap as $n) {
            $body[] = [":Expr", $line, [":Assign", $line, var($line, $n), [":Index", $line, var($line, "__cap"), str($line, $n)]]];
        }
        foreach ($f[5] as $s) { $body[] = $this->rw($s, $vis2); }
        $ps = [param("__cap")];
        $own = [];
        foreach ($f[3] as $p) {
            if ($p[4] !== null) { $p[4] = $this->rw($p[4], $vis2); }
            $ps[] = $p;
            $own[] = $p;
        }
        $this->lams[$id] = $own;
        $this->out[] = [":FuncStmt", $line, [":Func", $line, "__lam" . $id, $ps, $f[4], $body, false]];
        $items = [];
        foreach ($cap as $n) { $items[] = [":Item", 0, str($line, $n), var($line, $n)]; }
        return call($line, "zs_mkfn", [intl($line, $id), [":Array", $line, $items]]);
    }

    func rw($x, $vis) {
        if (!is_array($x)) { return $x; }
        if (!parser.isNode($x)) {
            $o = [];
            foreach ($x as $k => $v) { $o[$k] = $this->rw($v, $vis); }
            return $o;
        }
        $k = $x[0];
        if ($k === ":Closure") { return $this->lift($x, $vis); }
        if ($k === ":Call") { return $this->rwCall($x, $vis); }
        if ($k === ":Str" && has_key($this->fnp, $x[2])) { $this->named[$x[2]] = true; }
        $o = [];
        foreach ($x as $i => $v) { $o[$i] = $i < 2 ? $v : $this->rw($v, $vis); }
        return $o;
    }

    # tablica argumentów z kluczami (nazwane) i rozwinięciami
    func argsArray($line, $args, $vis) {
        $cur = null;
        $items = [];
        foreach ($args as $a) {
            $v = $this->rw($a[3], $vis);
            if ($a[4]) {
                $seg = [":Array", $line, $items];
                $cur = $cur === null ? $seg : call($line, "zs_spread", [$cur, $seg]);
                $cur = call($line, "zs_spread", [$cur, $v]);
                $items = [];
                $this->usesSpread = true;
            } else if ($a[2] !== null) {
                $items[] = [":Item", 0, str($line, $a[2]), $v];
            } else {
                $items[] = [":Item", 0, null, $v];
            }
        }
        if ($cur === null) { return [":Array", $line, $items]; }
        if (count($items) > 0) { $cur = call($line, "zs_spread", [$cur, [":Array", $line, $items]]); }
        return $cur;
    }

    func rwCall($x, $vis) {
        $line = $x[1];
        $callee = $x[2];
        $args = $x[3];
        $spread = false;
        $namedArg = false;
        foreach ($args as $a) { if ($a[4]) { $spread = true; } if ($a[2] !== null) { $namedArg = true; } }
        $kind = $callee[0];
        if ($kind === ":Name") {
            $n = $callee[2];
            if (has_key($this->fnp, $n) && ($spread || $namedArg)) {
                if ($spread) {
                    $this->named[$n] = true;
                    $this->dyn = true;
                    return call($line, "zs_call", [str($line, $n), $this->argsArray($line, $args, $vis)]);
                }
                return $this->reorder($x, $vis);
            }
            if ($spread || $namedArg) {
                $this->err($line, "argumenty nazwane i rozwinięcie ... niedostępne dla funkcji wbudowanych (" . $n . ")");
            }
            if ($n === "zs_spread" || $n === "zs_arg_missing" || $n === "zs_call") { $this->sawHelper = true; }
            return $this->plain($x, $vis);
        }
        if ($kind === ":Dot" || $kind === ":Prop") {
            if ($spread || $namedArg) { $this->err($line, "argumenty nazwane i rozwinięcie ... niedostępne dla wywołań modułów wbudowanych"); }
            return $this->plain($x, $vis);
        }
        # wywołanie wartości
        $this->dyn = true;
        return call($line, "zs_call", [$this->rw($callee, $vis), $this->argsArray($line, $args, $vis)]);
    }

    func plain($x, $vis) {
        $o = [":Call", $x[1], $this->rw($x[2], $vis), []];
        foreach ($x[3] as $a) { $a[3] = $this->rw($a[3], $vis); $o[3][] = $a; }
        return $o;
    }

    # argumenty nazwane przy znanej funkcji -> kolejność pozycyjna
    func reorder($x, $vis) {
        $line = $x[1];
        $n = $x[2][2];
        $ps = $this->fnp[$n];
        $slots = [];
        $pos = 0;
        $maxi = -1;
        foreach ($x[3] as $a) {
            $v = $this->rw($a[3], $vis);
            if ($a[2] === null) {
                $slots[$pos] = $v;
                if ($pos > $maxi) { $maxi = $pos; }
                $pos++;
                continue;
            }
            $j = -1;
            for ($i = 0; $i < count($ps); $i++) { if ($ps[$i][2] === $a[2] && !$ps[$i][5]) { $j = $i; } }
            if ($j < 0) { $this->err($line, $n . ": nieznany argument nazwany `" . $a[2] . "`"); return $x; }
            if (has_key($slots, $j)) { $this->err($line, $n . ": argument `" . $a[2] . "` podany dwukrotnie"); return $x; }
            $slots[$j] = $v;
            if ($j > $maxi) { $maxi = $j; }
        }
        $out = [];
        for ($i = 0; $i <= $maxi; $i++) {
            if (has_key($slots, $i)) { $out[] = arg($slots[$i]); continue; }
            if ($i < count($ps) && $ps[$i][4] !== null) { $out[] = arg($this->rw($ps[$i][4], $vis)); continue; }
            $pn = $i < count($ps) ? $ps[$i][2] : "?";
            $this->err($line, $n . ": brak argumentu $" . $pn);
            return $x;
        }
        return [":Call", $line, $x[2], $out];
    }

    func helpers() {
        $line = 0;
        $out = [];
        if ($this->n > 0 || $this->dyn || count($this->named) > 0) { $out[] = $this->dispatcher(); }
        $src = "func zs_arg_missing($f, $p) { throw new Error($f . \": brak argumentu $\" . $p); } "
             . "func zs_not_callable($f) { throw new Error(\"wartość typu \" . typeof($f) . \" nie jest wywoływalna\"); } "
             . "func zs_spread($a, $b) { foreach ($b as $k => $v) { if (is_int($k)) { $a[] = $v; } else { $a[$k] = $v; } } return $a; }";
        foreach (parser.parse($src) as $s) { $out[] = $s; }
        return $out;
    }

    func dispatcher() {
        $line = 0;
        $body = [];
        $body[] = [":Expr", $line, [":Assign", $line, var($line, "id"), call($line, "zs_fn_id", [var($line, "f")])]];
        $body[] = [":Expr", $line, [":Assign", $line, var($line, "cap"), call($line, "zs_fn_cap", [var($line, "f")])]];
        foreach ($this->lams as $id => $ps) {
            $args = prepend(arg(var($line, "cap")), bindArgs($line, $ps, "args", "{closure}"));
            $body[] = [":If", $line, [":Binary", $line, "Identical", var($line, "id"), intl($line, $id)],
                [[":Return", $line, [":Call", $line, nm($line, "__lam" . $id), $args]]], null];
        }
        foreach ($this->named as $fname => $t) {
            $body[] = [":If", $line, [":Binary", $line, "Identical", var($line, "id"), str($line, $fname)],
                [[":Return", $line, [":Call", $line, nm($line, $fname), bindArgs($line, $this->fnp[$fname], "args", $fname)]]], null];
        }
        $body[] = [":Return", $line, call($line, "zs_not_callable", [var($line, "f")])];
        return [":FuncStmt", $line, [":Func", $line, "zs_call", [param("f"), param("args")], [], $body, false]];
    }
}

func prepend($v, $xs) {
    $o = [$v];
    foreach ($xs as $x) { $o[] = $x; }
    return $o;
}

##
 * Zwraca ["ast" => instrukcje, "errors" => [[linia, kod, tekst]...]].
##
func lift($ast) {
    $l = new Lifter();
    foreach ($ast as $s) { if ($s[0] === ":FuncStmt") { $l->fnp[$s[2][2]] = $s[2][3]; } }
    $rest = [];
    foreach ($ast as $s) { if ($s[0] !== ":FuncStmt") { $rest[] = $s; } }
    $topvis = $l->names($rest);
    $out = [];
    foreach ($ast as $s) {
        if ($s[0] === ":FuncStmt") {
            $f = $s[2];
            $vis = $l->names($f[5]);
            foreach ($f[3] as $p) { $vis[$p[2]] = true; }
            $f[5] = $l->rw($f[5], $vis);
            $s[2] = $f;
            $out[] = $s;
        } else {
            $out[] = $l->rw($s, $topvis);
        }
    }
    if ($l->n === 0 && !$l->dyn && !$l->usesSpread && !$l->sawHelper) { return ["ast" => $out, "errors" => $l->errors]; }
    foreach ($l->out as $s) { $out[] = $s; }
    foreach ($l->helpers() as $s) { $out[] = $s; }
    return ["ast" => $out, "errors" => $l->errors];
}
