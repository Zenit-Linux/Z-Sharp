namespace spreadlit;

import Workspace.parser;

##
 * M3: rozwinięcie `...$tab` w literałach tablic: `[1, ...$a, "k" => 2, ...$b]`.
 * Semantyka jak w PHP: klucze całkowite są przenumerowywane (dopisywane na końcu), klucze tekstowe nadpisują.
 * Przepisanie na łańcuch wywołań pomocnika `zs_spread` (ten sam, którego używają argumenty `f(...$x)`; dokleja go lib/closures.zsharp):
 *     [a, ...$x, b]   =>   zs_spread(zs_spread([a], $x), [b])
 * Węzły `:Spread` są obecne tylko jako wartość elementu `:Item` w `:Array` — pass zastępuje je w całym drzewie.
##

func segment($line, $items) { return [":Array", $line, $items]; }

func spreadCall($line, $a, $b) {
    return [":Call", $line, [":Name", $line, "zs_spread"], [[":Arg", 0, null, $a, false], [":Arg", 0, null, $b, false]]];
}

func rewriteArray($n) {
    $line = $n[1];
    $has = false;
    foreach ($n[2] as $it) { if (parser.isNode($it[3]) && $it[3][0] === ":Spread") { $has = true; } }
    if (!$has) { return null; }
    $cur = null;
    $items = [];
    foreach ($n[2] as $it) {
        $v = $it[3];
        if (parser.isNode($v) && $v[0] === ":Spread") {
            $seg = segment($line, $items);
            $cur = $cur === null ? $seg : spreadCall($line, $cur, $seg);
            $cur = spreadCall($line, $cur, rewrite($v[2]));
            $items = [];
        } else {
            $items[] = [":Item", 0, $it[2] === null ? null : rewrite($it[2]), rewrite($v)];
        }
    }
    if (count($items) > 0) { $cur = spreadCall($line, $cur, segment($line, $items)); }
    return $cur;
}

func rewrite($x) {
    if (parser.isNode($x)) {
        if ($x[0] === ":Array") {
            $r = rewriteArray($x);
            if ($r !== null) { return $r; }
        }
        $o = [$x[0], $x[1]];
        for ($i = 2; $i < count($x); $i++) { $o[] = rewrite($x[$i]); }
        return $o;
    }
    if (is_array($x)) {
        $o = [];
        foreach ($x as $k => $v) { $o[$k] = rewrite($v); }
        return $o;
    }
    return $x;
}

##
 * Przepisuje listę instrukcji; zwraca nową listę (wejście bez `:Spread` wraca bez zmian semantycznych).
##
func desugar($ast) { return rewrite($ast); }
