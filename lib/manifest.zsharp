namespace manifest;

##
 * Parser Z#.toml w Z# — port stage0/zs-manifest (parse_toml, model manifestu, find_manifest).
 * Wartości: napis/int/float/bool → natywne; tablica → lista; tabela → TomlTable (uporządkowana mapa).
 * Błędy: TomlError (`line`, komunikat jak w Rust) i ManifestError.
##
class TomlError extends Exception {
    public $line;
    public func __construct($line, $msg) { parent.__construct($msg); $this->line = $line; }
}

class ManifestError extends Exception {
    public func __construct($msg) { parent.__construct($msg); }
}

class TomlTable {
    public $m;
    public func __construct() { $this->m = []; }
    public func has($k) { return has_key($this->m, $k); }
    public func get($k) { return $this->m[$k] ?? null; }
    public func set($k, $v) { $this->m[$k] = $v; }
    public func count() { return count($this->m); }
    # klucze posortowane bajtowo (jak BTreeMap)
    public func sortedKeys() {
        $ks = [];
        foreach ($this->m as $k => $v) { $ks[] = strval($k); }
        for ($i = 1; $i < count($ks); $i++) {
            $x = $ks[$i];
            $j = $i - 1;
            while ($j >= 0 && $ks[$j] > $x) { $ks[$j + 1] = $ks[$j]; $j--; }
            $ks[$j + 1] = $x;
        }
        return $ks;
    }
}

class TomlCur {
    public $s;
    public $n;
    public $i;
    public $line;
    public func __construct($text) { $this->s = chars($text); $this->n = count($this->s); $this->i = 0; $this->line = 1; }
    public func peek() { return $this->i < $this->n ? $this->s[$this->i] : null; }
    public func at($k) { return $this->i + $k < $this->n ? $this->s[$this->i + $k] : null; }
    public func ws() { while ($this->peek() === " " || $this->peek() === "\t") { $this->i++; } }
    public func skipComment() { while ($this->peek() !== null && $this->peek() !== "\n") { $this->i++; } }
    public func wsNl() {
        while (true) {
            $c = $this->peek();
            if ($c === " " || $c === "\t" || $c === "\r") { $this->i++; }
            else if ($c === "\n") { $this->i++; $this->line++; }
            else if ($c === "#") { $this->skipComment(); }
            else { break; }
        }
    }
    public func eat($c) { if ($this->peek() === $c) { $this->i++; return true; } return false; }
    public func restIsBlank() {
        $this->ws();
        if ($this->peek() === "#") { $this->skipComment(); }
        $c = $this->peek();
        return $c === null || $c === "\n" || $c === "\r";
    }
}

func fail($line, $msg) { throw new TomlError($line, $msg); }

func isBare($c) {
    if ($c === null || strlen($c) !== 1) { return false; }
    $o = ord($c);
    return ($o >= 48 && $o <= 57) || ($o >= 65 && $o <= 90) || ($o >= 97 && $o <= 122) || $c === "_" || $c === "-";
}

func hexVal($c) {
    $o = ord($c);
    if (strlen($c) !== 1) { return -1; }
    if ($o >= 48 && $o <= 57) { return $o - 48; }
    if ($o >= 97 && $o <= 102) { return $o - 87; }
    if ($o >= 65 && $o <= 70) { return $o - 55; }
    return -1;
}

func parseString($c) {
    $q = $c->peek();
    $c->i++;
    $out = "";
    while (true) {
        $ch = $c->peek();
        if ($ch === null || $ch === "\n") { fail($c->line, "niezamknięty napis"); }
        if ($ch === $q) { $c->i++; break; }
        if ($ch === "\\" && $q === "\"") {
            $c->i++;
            $e = $c->peek();
            if ($e === null) { fail($c->line, "ucięta sekwencja ucieczki"); }
            $c->i++;
            if ($e === "n") { $out .= "\n"; }
            else if ($e === "t") { $out .= "\t"; }
            else if ($e === "r") { $out .= "\r"; }
            else if ($e === "\"") { $out .= "\""; }
            else if ($e === "\\") { $out .= "\\"; }
            else if ($e === "0") { $out .= chr(0); }
            else if ($e === "u" || $e === "U") {
                $n = $e === "u" ? 4 : 8;
                $cp = 0;
                $ok = $c->i + $n <= $c->n;
                for ($k = 0; $k < $n && $ok; $k++) {
                    $h = hexVal($c->s[$c->i + $k]);
                    if ($h < 0) { $ok = false; } else { $cp = $cp * 16 + $h; }
                }
                if (!$ok || $cp > 1114111 || ($cp >= 55296 && $cp <= 57343)) { fail($c->line, "niepoprawna sekwencja \\u"); }
                $out .= chr($cp);
                $c->i += $n;
            }
            else { fail($c->line, "nieznana sekwencja ucieczki \\" . $e); }
        }
        else { $out .= $ch; $c->i++; }
    }
    return $out;
}

func parseKeyPart($c) {
    $c->ws();
    $p = $c->peek();
    if ($p === "\"" || $p === "'") { return parseString($c); }
    if (isBare($p)) {
        $out = "";
        while (isBare($c->peek())) { $out .= $c->peek(); $c->i++; }
        return $out;
    }
    fail($c->line, "oczekiwano klucza");
}

func parseKeyPath($c) {
    $p = [parseKeyPart($c)];
    while (true) {
        $c->ws();
        if ($c->eat(".")) { $p[] = parseKeyPart($c); } else { break; }
    }
    return $p;
}

func isDigits($s) {
    if ($s === "") { return false; }
    foreach (chars($s) as $ch) { $o = ord($ch); if (strlen($ch) !== 1 || $o < 48 || $o > 57) { return false; } }
    return true;
}

func parseInt($t) {
    $neg = false;
    $d = $t;
    if (starts_with($d, "-")) { $neg = true; $d = substr($d, 1); }
    else if (starts_with($d, "+")) { $d = substr($d, 1); }
    if (!isDigits($d)) { return null; }
    if (strlen($d) > 19) { return null; }
    return $neg ? -intval($d) : intval($d);
}

func parseFloat($t) {
    $d = $t;
    if (starts_with($d, "-") || starts_with($d, "+")) { $d = substr($d, 1); }
    if ($d === "") { return null; }
    $seenDigit = false;
    $seenDot = false;
    $seenExp = false;
    $cs = chars($d);
    for ($k = 0; $k < count($cs); $k++) {
        $ch = $cs[$k];
        if (isDigits($ch)) { $seenDigit = true; }
        else if ($ch === "." && !$seenDot && !$seenExp) { $seenDot = true; }
        else if (($ch === "e" || $ch === "E") && $seenDigit && !$seenExp) {
            $seenExp = true;
            if ($k + 1 < count($cs) && ($cs[$k + 1] === "+" || $cs[$k + 1] === "-")) { $k++; }
            if ($k + 1 >= count($cs)) { return null; }
        }
        else { return null; }
    }
    if (!$seenDigit) { return null; }
    return floatval($t);
}

func parseValue($c) {
    $c->ws();
    $p = $c->peek();
    if ($p === null) { fail($c->line, "brak wartości"); }
    if ($p === "\"" || $p === "'") {
        if ($c->at(1) === $p && $c->at(2) === $p) { fail($c->line, "napisy wieloliniowe nie są wspierane w Z#.toml"); }
        return parseString($c);
    }
    if ($p === "[") {
        $c->i++;
        $v = [];
        while (true) {
            $c->wsNl();
            if ($c->eat("]")) { break; }
            $v[] = parseValue($c);
            $c->wsNl();
            if ($c->eat(",")) { continue; }
            $c->wsNl();
            if ($c->eat("]")) { break; }
            fail($c->line, "oczekiwano ',' lub ']' w tablicy");
        }
        return $v;
    }
    if ($p === "{") {
        $c->i++;
        $t = new TomlTable();
        $c->ws();
        if ($c->eat("}")) { return $t; }
        while (true) {
            $path = parseKeyPath($c);
            $c->ws();
            if (!$c->eat("=")) { fail($c->line, "oczekiwano '='"); }
            $v = parseValue($c);
            insertPath($t, $path, 0, $v, $c->line);
            $c->ws();
            if ($c->eat(",")) { continue; }
            if ($c->eat("}")) { break; }
            fail($c->line, "oczekiwano ',' lub '}' w tabeli inline");
        }
        return $t;
    }
    $tok = "";
    while (true) {
        $ch = $c->peek();
        if ($ch === null || $ch === "," || $ch === "]" || $ch === "}" || $ch === "#" || $ch === "\n" || $ch === "\r" || $ch === " " || $ch === "\t") { break; }
        $tok .= $ch;
        $c->i++;
    }
    if ($tok === "true") { return true; }
    if ($tok === "false") { return false; }
    if ($tok === "") { fail($c->line, "brak wartości"); }
    $t = replace($tok, "_", "");
    if (starts_with($t, "0x")) {
        $h = substr($t, 2);
        if ($h === "" || strlen($h) > 15) { fail($c->line, "zła liczba hex"); }
        $n = 0;
        foreach (chars($h) as $ch) { $d = hexVal($ch); if ($d < 0) { fail($c->line, "zła liczba hex"); } $n = $n * 16 + $d; }
        return $n;
    }
    $i = parseInt($t);
    if ($i !== null) { return $i; }
    $f = parseFloat($t);
    if ($f !== null) { return $f; }
    fail($c->line, "nierozpoznana wartość `" . $tok . "`");
}

func insertPath($t, $path, $idx, $v, $line) {
    $k = $path[$idx];
    if ($idx === count($path) - 1) {
        if ($t->has($k)) { fail($line, "zduplikowany klucz `" . $k . "`"); }
        $t->set($k, $v);
        return;
    }
    if (!$t->has($k)) { $t->set($k, new TomlTable()); }
    $sub = $t->get($k);
    if (!($sub instanceof TomlTable)) { fail($line, "`" . $k . "` nie jest tabelą"); }
    insertPath($sub, $path, $idx + 1, $v, $line);
}

# tabela docelowa dla nagłówka [a.b] / [[a.b]] (array = dodaj nowy element)
func openTable($root, $path, $array, $line) {
    $cur = $root;
    for ($i = 0; $i < count($path); $i++) {
        $seg = $path[$i];
        $last = $i + 1 === count($path);
        if ($last && $array) {
            if (!$cur->has($seg)) { $cur->set($seg, []); }
            $e = $cur->get($seg);
            if (!is_array($e)) { fail($line, "`" . $seg . "` nie jest tablicą tabel"); }
            $nt = new TomlTable();
            $e[] = $nt;
            $cur->set($seg, $e);
            return $nt;
        }
        if (!$cur->has($seg)) { $cur->set($seg, new TomlTable()); }
        $e = $cur->get($seg);
        if ($e instanceof TomlTable) { $cur = $e; }
        else if (is_array($e) && count($e) > 0 && $e[count($e) - 1] instanceof TomlTable) { $cur = $e[count($e) - 1]; }
        else { fail($line, "`" . $seg . "` nie jest tabelą"); }
    }
    return $cur;
}

func openTableNopush($root, $path, $line) { return openTable($root, $path, false, $line); }

##
 * Parsuje tekst TOML do TomlTable (tabela główna).
##
func parse_toml($text) {
    if (starts_with($text, chr(65279))) { $text = substr($text, strlen(chr(65279))); }
    $c = new TomlCur($text);
    $root = new TomlTable();
    $curPath = [];
    while (true) {
        $c->wsNl();
        if ($c->peek() === null) { break; }
        if ($c->peek() === "[") {
            $c->i++;
            $arr = $c->eat("[");
            $path = parseKeyPath($c);
            $c->ws();
            if (!$c->eat("]")) { fail($c->line, "oczekiwano ']'"); }
            if ($arr && !$c->eat("]")) { fail($c->line, "oczekiwano ']]'"); }
            if (!$c->restIsBlank()) { fail($c->line, "śmieci po nagłówku tabeli"); }
            $curPath = $path;
            openTable($root, $curPath, $arr, $c->line);
            continue;
        }
        $path = parseKeyPath($c);
        $c->ws();
        if (!$c->eat("=")) { fail($c->line, "oczekiwano '='"); }
        $line = $c->line;
        $v = parseValue($c);
        if (!$c->restIsBlank()) { fail($c->line, "śmieci po wartości"); }
        $t = count($curPath) === 0 ? $root : openTableNopush($root, $curPath, $line);
        insertPath($t, $path, 0, $v, $line);
    }
    return $root;
}

func quote($s) {
    $out = "\"";
    foreach (chars($s) as $ch) {
        if ($ch === "\"") { $out .= "\\\""; }
        else if ($ch === "\\") { $out .= "\\\\"; }
        else if ($ch === "\n") { $out .= "\\n"; }
        else if ($ch === "\t") { $out .= "\\t"; }
        else if ($ch === "\r") { $out .= "\\r"; }
        else { $out .= $ch; }
    }
    return $out . "\"";
}

##
 * Zrzut tekstowy jak `zs_manifest::dump` (tabele z posortowanymi kluczami).
##
func dump($v, $indent = 0) {
    $pad = repeat("  ", $indent);
    if (is_string($v)) { return quote($v); }
    if (is_bool($v)) { return $v ? "true" : "false"; }
    if (is_float($v)) {
        $s = strval($v);
        return ends_with($s, ".0") ? substr($s, 0, strlen($s) - 2) : $s;
    }
    if (is_array($v)) {
        $p = [];
        foreach ($v as $x) { $p[] = dump($x, $indent); }
        return "[" . join($p, ", ") . "]";
    }
    if ($v instanceof TomlTable) {
        $s = "{\n";
        foreach ($v->sortedKeys() as $k) { $s .= $pad . "  " . $k . " = " . dump($v->get($k), $indent + 1) . "\n"; }
        return $s . $pad . "}";
    }
    return strval($v);
}

func typeName($v) {
    if (is_string($v)) { return "string"; }
    if (is_bool($v)) { return "bool"; }
    if (is_int($v)) { return "int"; }
    if (is_float($v)) { return "float"; }
    if (is_array($v)) { return "array"; }
    return "table";
}

func getStr($t, $k) { $v = $t->get($k); return is_string($v) ? $v : null; }

func validIdent($s) {
    if ($s === "") { return false; }
    $cs = chars($s);
    $o = ord($cs[0]);
    if (!(($o >= 65 && $o <= 90) || ($o >= 97 && $o <= 122) || $cs[0] === "_")) { return false; }
    foreach ($cs as $ch) { if (!isBare($ch) || $ch === "-") { return false; } }
    return true;
}

func mfail($msg) { throw new ManifestError("Z#.toml: " . $msg); }

##
 * Model manifestu (assoc): name, version, kind ("bin"|"lib"), entry, description, license,
 * members (TomlTable nazwa => ścieżka), dependencies (lista), externs (lista), memory (TomlTable), raw, dir.
##
func parse($text, $dir) {
    try { $raw = parse_toml($text); }
    catch (TomlError $e) { throw new ManifestError("Z#.toml:" . $e->line . ": " . $e->getMessage()); }
    $pkg = $raw->get("package");
    $ws = $raw->get("workspace");
    $pkgT = $pkg instanceof TomlTable ? $pkg : null;
    $wsT = $ws instanceof TomlTable ? $ws : null;
    if ($pkgT === null && $wsT === null) { mfail("wymagana sekcja [package] lub [workspace]"); }
    if ($pkgT === null) { $pkgT = new TomlTable(); }
    $name = getStr($pkgT, "name") ?? "";
    if ($pkgT->has("name") && $name === "") { mfail("[package].name nie może być pusty"); }
    $kind = getStr($pkgT, "kind");
    if ($kind === null || $kind === "bin") { $kind = "bin"; }
    else if ($kind !== "lib") { mfail("[package].kind: `" . $kind . "` (dozwolone: bin, lib)"); }
    $version = getStr($pkgT, "version") ?? "0.0.0";
    $parts = split($version, ".");
    $okv = count($parts) === 3;
    foreach ($parts as $p) { if (!isDigits($p) || strlen($p) > 10) { $okv = false; } }
    if (!$okv) { mfail("[package].version `" . $version . "` nie jest w formie MAJOR.MINOR.PATCH"); }
    $members = new TomlTable();
    if ($wsT !== null && $wsT->has("members")) {
        $m = $wsT->get("members");
        if (!($m instanceof TomlTable)) { mfail("[workspace.members] musi być tabelą nazwa = \"ścieżka\""); }
        foreach ($m->sortedKeys() as $k) {
            if (!validIdent($k)) { mfail("człon workspace'u `" . $k . "` nie jest poprawnym identyfikatorem Z#"); }
            $pth = $m->get($k);
            if (!is_string($pth)) { mfail("człon `" . $k . "`: ścieżka musi być napisem"); }
            $members->set($k, $pth);
        }
    }
    $deps = [];
    $d = $raw->get("dependencies");
    if ($d instanceof TomlTable) {
        foreach ($d->sortedKeys() as $k) {
            $v = $d->get($k);
            if (is_string($v)) { $deps[] = ["name" => $k, "path" => null, "git" => null, "version" => $v, "rev" => null]; }
            else if ($v instanceof TomlTable) {
                $deps[] = ["name" => $k, "path" => getStr($v, "path"), "git" => getStr($v, "git"), "version" => getStr($v, "version"), "rev" => getStr($v, "rev")];
            }
            else { mfail("[dependencies]." . $k . ": oczekiwano napisu lub tabeli, jest " . typeName($v)); }
        }
    }
    $externs = [];
    $x = $raw->get("extern");
    if ($x instanceof TomlTable) {
        foreach ($x->sortedKeys() as $k) {
            $t = $x->get($k);
            if (!($t instanceof TomlTable)) { mfail("[extern." . $k . "] musi być tabelą"); }
            $ek = getStr($t, "kind") ?? "static";
            if (!in_array($ek, ["static", "dylib", "framework"])) { mfail("[extern." . $k . "].kind `" . $ek . "` (static|dylib)"); }
            $externs[] = ["name" => $k, "kind" => $ek, "path" => getStr($t, "path"), "headers" => strList($t->get("headers")), "link_args" => strList($t->get("link-args"))];
        }
    }
    $memory = $raw->get("memory");
    if (!($memory instanceof TomlTable)) { $memory = new TomlTable(); }
    if ($kind === "bin" && $pkgT->has("name") && getStr($pkgT, "entry") === null) { mfail("pakiet typu bin wymaga [package].entry"); }
    return ["dir" => $dir, "name" => $name, "version" => $version, "kind" => $kind, "entry" => getStr($pkgT, "entry"),
        "description" => getStr($pkgT, "description") ?? "", "license" => getStr($pkgT, "license") ?? "",
        "members" => $members, "dependencies" => $deps, "externs" => $externs, "memory" => $memory, "raw" => $raw];
}

func strList($v) {
    $out = [];
    if (is_array($v)) { foreach ($v as $x) { if (is_string($x)) { $out[] = $x; } } }
    return $out;
}

func join_path($dir, $p) { return starts_with($p, "/") ? $p : ($dir === "" ? $p : $dir . "/" . $p); }

func load($dir) {
    $f = $dir . "/Z#.toml";
    if (!File.exists($f)) { throw new ManifestError($f . ": No such file or directory (os error 2)"); }
    return parse(File.read($f), $dir);
}

# najbliższy katalog z Z#.toml idąc w górę od `start` (ścieżka bezwzględna)
func find_manifest($start) {
    $d = $start;
    while (true) {
        if (File.exists($d . "/Z#.toml")) { return $d; }
        $up = System.dirname($d);
        if ($up === null || $up === $d || $up === "") { return null; }
        $d = $up;
    }
}

func member_path($m, $name) {
    $p = $m["members"]->get($name);
    return $p === null ? null : join_path($m["dir"], $p);
}

##
 * Tekst jak `zsc0 manifest <dir>`: zwraca [linie, liczba_brakujących_plików].
##
func report($root, $m) {
    $out = [];
    $out[] = "manifest: " . $root . "/Z#.toml";
    $out[] = "pakiet:   " . ($m["name"] === "" ? "-" : $m["name"]) . " " . $m["version"] . " (" . ($m["kind"] === "bin" ? "Bin" : "Lib") . ")"
        . ($m["entry"] !== null ? ", entry=" . $m["entry"] : "");
    $bad = 0;
    foreach ($m["members"]->sortedKeys() as $name) {
        $p = $m["members"]->get($name);
        $ok = File.exists(join_path($m["dir"], $p));
        if (!$ok) { $bad++; }
        $out[] = "  Workspace." . pad_right($name, 10) . " " . $p . " " . ($ok ? "ok" : "BRAK PLIKU");
    }
    foreach ($m["dependencies"] as $d) {
        $found = $d["path"] === null ? null : File.exists(join_path(join_path($m["dir"], $d["path"]), "Z#.toml"));
        $tail = $found === null ? "" : ($found ? "ok" : "(katalog zależności nieobecny)");
        $out[] = "  dep " . pad_right($d["name"], 12) . " path=" . ($d["path"] ?? "-") . " git=" . ($d["git"] ?? "-") . " " . $tail;
    }
    foreach ($m["externs"] as $x) { $out[] = "  extern " . $x["name"] . " (" . $x["kind"] . ") " . ($x["path"] ?? ""); }
    if ($m["memory"]->count() > 0) {
        $parts = [];
        foreach ($m["memory"]->sortedKeys() as $k) { $parts[] = $k . "=" . dump($m["memory"]->get($k), 0); }
        $out[] = "  [memory] " . join($parts, ", ");
    }
    return [$out, $bad];
}

##
 * Tabela [memory] jako zwykła mapa (do zamm.config_from).
##
func memory_map($m) {
    $out = [];
    foreach ($m["memory"]->sortedKeys() as $k) { $out[$k] = $m["memory"]->get($k); }
    return $out;
}
